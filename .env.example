# After you deploy the Web app from google-apps-script/Code.gs (bound to your sheet),
# paste the deployment URL here. Required for Vercel and for local `npm run dev`
# (copy this file to .env.local — Vite loads it automatically).
APPS_SCRIPT_WEB_APP_URL=

# Optional: same value as Script property SUBMIT_SECRET in Apps Script (server-side only).
APPS_SCRIPT_SUBMIT_SECRET=

# The app calls GET /api/warmup on load (Vercel: api/warmup.js) to wake the Web App
# before the user submits — reduces cold-start delay on the first row.

# Admin dashboard (/admin): long random string. Sent as Authorization: Bearer …
ADMIN_TOKEN=

# Same value as Apps Script script property ADMIN_SECRET (required for sheet list API).
APPS_SCRIPT_ADMIN_SECRET=
